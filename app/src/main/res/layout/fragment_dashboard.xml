<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <TextView
            android:id="@+id/labelOverview"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dash_label_overview"
            android:layout_marginTop="@dimen/space_md" />

        <TextView
            android:id="@+id/heroPeriod"
            style="@style/TextAppearance.Checkly.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="This week" />

        <LinearLayout
            android:id="@+id/filterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                android:id="@+id/dailyFilter"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_xs"
                android:text="@string/dash_filter_daily"
                android:textColor="@color/text_muted"
                android:background="@drawable/chip_filter_bg"
                android:gravity="center"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/weeklyFilter"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_xs"
                android:text="@string/dash_filter_weekly"
                android:textColor="@color/text_muted"
                android:background="@drawable/chip_filter_bg"
                android:gravity="center"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/monthlyFilter"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_xs"
                android:text="@string/dash_filter_monthly"
                android:textColor="@color/text_muted"
                android:background="@drawable/chip_filter_bg"
                android:gravity="center"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/customFilter"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dash_filter_custom"
                android:textColor="@color/text_muted"
                android:background="@drawable/chip_filter_bg"
                android:gravity="center"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/kpiOnTimeCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elev_card"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/kpiOnTime"
                    style="@style/TextAppearance.Checkly.Headline"
                    android:textSize="22sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="87%" />

                <TextView
                    style="@style/TextAppearance.Checkly.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/dash_kpi_on_time" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kpiOverdueCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elev_card"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/kpiOverdue"
                    style="@style/TextAppearance.Checkly.Headline"
                    android:textSize="22sp"
                    android:textColor="@color/danger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="4" />

                <TextView
                    style="@style/TextAppearance.Checkly.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/dash_kpi_overdue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kpiDoneCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elev_card"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/kpiDone"
                    style="@style/TextAppearance.Checkly.Headline"
                    android:textSize="22sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="42" />

                <TextView
                    style="@style/TextAppearance.Checkly.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/dash_kpi_done" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elev_card"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dash_chart_h" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChart"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/space_sm" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/staffRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:ignore="UnusedIds" />

        <Button
            android:id="@+id/addTaskBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="UnusedIds" />

        <Button
            android:id="@+id/addNewStaff"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="UnusedIds" />

        <TextView
            android:id="@+id/taskStatusInPercentage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="UnusedIds" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
