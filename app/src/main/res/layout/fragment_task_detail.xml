<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.TaskDetailFragment">

    <ImageView
        android:id="@+id/toolbar"
        android:layout_width="@dimen/size_icon_btn"
        android:layout_height="@dimen/size_icon_btn"
        android:src="@drawable/ic_back"
        android:background="@drawable/bg_icon_btn"
        android:padding="6dp"
        android:contentDescription="@string/content_desc_back"
        android:layout_marginStart="@dimen/space_base"
        android:layout_marginTop="@dimen/space_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/taskEditBtn"
        android:layout_width="@dimen/size_icon_btn"
        android:layout_height="@dimen/size_icon_btn"
        android:src="@drawable/ic_edit"
        android:background="@drawable/bg_icon_btn"
        android:padding="6dp"
        android:contentDescription="@string/content_desc_edit"
        android:layout_marginEnd="@dimen/space_base"
        android:layout_marginTop="@dimen/space_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/screenLabel"
        style="@style/TextAppearance.Checkly.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_detail_label"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:paddingHorizontal="@dimen/space_base"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/composer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/taskTitle"
                style="@style/TextAppearance.Checkly.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Restock fridge — main bar" />

            <TextView
                android:id="@+id/taskDescription"
                style="@style/TextAppearance.Checkly.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="Ensure all bottled drinks are above the fill line." />

            <TextView
                android:id="@+id/taskStatus"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_status_in_progress"
                android:textColor="@color/text_on_primary"
                android:layout_marginTop="@dimen/space_md"
                tools:text="In progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elev_card"
                android:padding="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        style="@style/TextAppearance.Checkly.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_time_start" />

                    <TextView
                        android:id="@+id/startTime"
                        style="@style/TextAppearance.Checkly.Headline"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="09:00" />
                </LinearLayout>

                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        style="@style/TextAppearance.Checkly.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_time_due" />

                    <TextView
                        android:id="@+id/taskDueTime"
                        style="@style/TextAppearance.Checkly.Headline"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="09:30" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/commentsHeader"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                tools:text="Comments · 3" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                tools:listitem="@layout/item_comment" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/taskDeleteBtn"
                style="@style/Widget.Checkly.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_secondary"
                android:text="@string/action_delete"
                android:textColor="@color/danger"
                android:layout_marginTop="@dimen/space_lg" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md"
        android:background="@color/surface_card"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/addCommentEt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/height_input"
            android:background="@drawable/bg_input_card"
            android:elevation="@dimen/elev_card"
            android:hint="@string/task_comments_compose_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:fontFamily="sans-serif"
            android:textSize="13sp"
            android:paddingHorizontal="@dimen/space_md"
            android:inputType="text" />

        <ImageView
            android:id="@+id/sendComment"
            android:layout_width="@dimen/size_icon_btn"
            android:layout_height="@dimen/size_icon_btn"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_fab"
            app:tint="@color/text_on_primary"
            android:padding="6dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/content_desc_send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
