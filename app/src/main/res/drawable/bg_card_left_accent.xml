<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <solid android:color="@color/surface_card" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/radius_card"
                android:bottomLeftRadius="@dimen/radius_card"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
