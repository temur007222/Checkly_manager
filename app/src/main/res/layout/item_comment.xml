<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_md"
    android:layout_marginVertical="@dimen/space_xs"
    android:elevation="@dimen/elev_card">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/commentAvatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_avatar_a"
        android:contentDescription="@string/content_desc_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/commentAuthor"
        style="@style/TextAppearance.Checkly.BodySmall"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        app:layout_constraintTop_toTopOf="@id/commentAvatar"
        app:layout_constraintBottom_toBottomOf="@id/commentAvatar"
        app:layout_constraintStart_toEndOf="@id/commentAvatar"
        app:layout_constraintEnd_toStartOf="@id/commentTime"
        tools:text="Aziza" />

    <TextView
        android:id="@+id/commentTime"
        style="@style/TextAppearance.Checkly.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/commentAvatar"
        app:layout_constraintBottom_toBottomOf="@id/commentAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="09:14" />

    <TextView
        android:id="@+id/commentText"
        style="@style/TextAppearance.Checkly.BodySmall"
        android:textColor="@color/text_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        app:layout_constraintTop_toBottomOf="@id/commentAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Found 2 broken bottles, threw them out." />

</androidx.constraintlayout.widget.ConstraintLayout>
