<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.AddStaffFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_base">

        <ImageView
            android:id="@+id/toolbar"
            android:layout_width="@dimen/size_icon_btn"
            android:layout_height="@dimen/size_icon_btn"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_btn"
            android:padding="6dp"
            android:contentDescription="@string/content_desc_back"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/screenLabel"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_label"
            app:layout_constraintTop_toTopOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/heroTitle"
            style="@style/TextAppearance.Checkly.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_h"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/photoUploadGroup"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_photo_upload_circle"
            android:layout_marginTop="@dimen/space_md"
            android:foreground="?attr/selectableItemBackground"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/heroTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/primary"
                    android:contentDescription="@null" />

                <TextView
                    style="@style/TextAppearance.Checkly.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/add_staff_photo_cta"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <ImageView
                android:id="@+id/profilePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/content_desc_avatar"
                tools:visibility="visible" />
        </FrameLayout>

        <Button
            android:id="@+id/selectPhotoButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="UnusedIds"
            app:layout_constraintTop_toTopOf="@id/photoUploadGroup"
            app:layout_constraintStart_toStartOf="@id/photoUploadGroup" />

        <TextView
            android:id="@+id/labelName"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_field_name"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/photoUploadGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/staffInputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:autofillHints="personFullName" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/labelRole"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_field_role"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/nameInputLayout"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/roleInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxStrokeColor="@color/primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelRole"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/staffRoleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/labelEmail"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_field_email"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/roleInputLayout"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/staffEmailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/labelPassword"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_staff_field_password"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/emailInputLayout"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/staffPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/passwordInputLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Checkly.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/height_button_secondary"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Checkly.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/height_button_cta"
                android:text="@string/add_staff_save"
                android:layout_marginStart="@dimen/space_sm" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
